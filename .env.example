# =============================================================================
# Whimsical Writer — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.  NEVER commit the real
# `.env` (it is gitignored).  Only `VITE_`-prefixed vars are exposed to the
# browser — keep every other key server-side only.
#
# In production, set these in your hosting dashboard (Vercel → Project →
# Settings → Environment Variables). See the deployment checklist at the bottom.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED) — PostgreSQL connection string (Neon, Supabase, etc.)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# -----------------------------------------------------------------------------
# AI provider (at least ONE key required for AI features)
# Priority order (top wins): GROQ → GROK → DEEPSEEK → GEMINI → OPENROUTER
# -----------------------------------------------------------------------------
GROQ_API_KEY=""
GROK_API_KEY=""
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Public URL of the frontend, sent as HTTP-Referer to OpenRouter. Optional.
APP_URL="http://localhost:8080"

# -----------------------------------------------------------------------------
# Clerk authentication (all OPTIONAL — omit to run in guest-only mode)
#   VITE_CLERK_PUBLISHABLE_KEY is the ONLY key exposed to the browser and is
#   safe to publish. CLERK_SECRET_KEY is a server secret — never expose it.
# -----------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Guest cookie signing (OPTIONAL but recommended in production)
# Persistent HMAC secret for signing the wa_guest cookie. If unset, a random
# one is generated per server start (invalidating guest cookies on restart).
# Generate one with:  openssl rand -hex 32
# -----------------------------------------------------------------------------
GUEST_ID_SECRET=""

# -----------------------------------------------------------------------------
# CORS allowlist (OPTIONAL)
# Comma-separated list of extra allowed origins. Same-origin (the production
# domain + Vercel preview URLs) and localhost in dev are always allowed.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=""

# -----------------------------------------------------------------------------
# Per-user token limit overrides (OPTIONAL)
# JSON map of user IDs to custom daily AI token limits.
# Users not listed get the default (10000). Example:
#   USER_TOKEN_LIMITS='{"user_3Elz4gPWW6qOgq4ESVEOzSzRzQY":20000}'
# -----------------------------------------------------------------------------
USER_TOKEN_LIMITS=""

# -----------------------------------------------------------------------------
# Runtime (set automatically by the host — usually no need to set manually)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST (Vercel)
# =============================================================================
# Set these in: Vercel → your project → Settings → Environment Variables
#
#   DATABASE_URL              (Required)
#   GROQ_API_KEY              (or another AI provider key — Required for AI)
#   APP_URL                   (e.g. https://whimsicalwriter.vercel.app)
#   VITE_CLERK_PUBLISHABLE_KEY (if sign-in is enabled)
#   CLERK_PUBLISHABLE_KEY      (if sign-in is enabled)
#   CLERK_SECRET_KEY           (if sign-in is enabled)
#   GUEST_ID_SECRET            (Recommended — openssl rand -hex 32)
#   ALLOWED_ORIGINS            (e.g. https://whimsicalwriter.vercel.app)
#   USER_TOKEN_LIMITS          (per-user daily limit overrides — optional)
# =============================================================================
