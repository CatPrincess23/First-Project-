{
  "installCommand": "cd Writer-Assistant && corepack enable && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd Writer-Assistant && pnpm run build:vercel",
  "outputDirectory": "Writer-Assistant/artifacts/writer/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
