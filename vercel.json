{
  "buildCommand": "cd Writer-Assistant && bash build-vercel.sh",
  "outputDirectory": "Writer-Assistant/artifacts/writer/dist/public",
  "installCommand": "cd Writer-Assistant && pnpm install --no-frozen-lockfile",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
